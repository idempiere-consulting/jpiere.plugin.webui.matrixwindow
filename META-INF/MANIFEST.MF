Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: jpiere.plugin.webui.matrixwindow
Bundle-SymbolicName: jpiere.plugin.webui.matrixwindow;singleton:=true
Bundle-Version: 11.0.0.qualifier
Bundle-Vendor: OSS ERP Solutions
Require-Bundle: org.adempiere.base,
 org.adempiere.ui,
 org.adempiere.ui.zk,
 org.eclipse.osgi,
 org.adempiere.plugin.utils,
 org.idempiere.zk.extra,
 zk,
 zkbind,
 zkplus,
 zcommon,
 zul,
 zhtml,
 zweb,
 wrapped.org.apache.poi.poi;bundle-version="4.1.2"
Service-Component: OSGI-INF/*.xml
Import-Package: de.aulerlichtkabel.infodialog;resolution:=optional,
 de.aulerlichtkabel.infodialog.component;resolution:=optional,
 de.aulerlichtkabel.infodialog.model;resolution:=optional,
 org.apache.poi.hssf.usermodel,
 org.compiere.model,
 org.osgi.service.event,
 org.slf4j;version="1.7.2",
 org.slf4j.helpers;version="1.7.2",
 org.slf4j.spi;version="1.7.2"
Bundle-ActivationPolicy: lazy
Export-Package: jpiere.plugin.matrixwindow.base,
 jpiere.plugin.matrixwindow.form,
 jpiere.plugin.matrixwindow.model
Automatic-Module-Name: jpiere.plugin.webui.matrixwindow
Bundle-RequiredExecutionEnvironment: JavaSE-17
